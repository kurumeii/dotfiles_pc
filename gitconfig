[user]
	name = "{{username}}"
	email = "{{email}}"
[credential]
	helper = manager
[core]
	autocrlf = true
[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
		cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    prompt = false
[pager]
    difftool = true
[diff]
tool = difftastic
[merge]
	tool = nvim
