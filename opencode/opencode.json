{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "ask",
    "list": "allow",
    "grep": "allow",
    "glob": "allow",
    "external_directory": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "username": "😺 Andrew Nguyen",
  "plugin": [
    "opencode-gemini-auth",
    "opencode-agent-skills"
  ],
  "experimental": {
    "batch_tool": true,
  },
  "command": {
    "messages": {
      "description": "Auto generate message",
      "template": "Generate git convention message for changes"
    }
  },
  "mcp": {
    "serena": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:12345/mcp",
      "timeout": 2000
    },
    "context7": {
      "enabled": true,
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "api-key": "{env:CONTEXT_7_API_KEY}"
      }
    },
    "tavily": {
      "enabled": true,
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "tavily-mcp@latest"
      ],
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    },
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "braveSearch": {
      "enabled": false,
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  }
}
