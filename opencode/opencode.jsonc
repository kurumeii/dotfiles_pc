{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "compaction": {
    "buffer": "30%"
  },
  "websearch": {
    "provider": "exa"
  },
  "instructions": [
    "~/.config/opencode/instructions/*.md"
  ],
  "plugins": [
    "github:ionutale/opencode-go-usage-plugin"
  ],
  "mcp": {
    "servers": {
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ],
        "enabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "chrome-devtools-mcp@1.13.0",
          "--executablePath",
          "/home/andrew.nguyen1@Techvify.Internal/.local/bin/chrome-ct",
          "--headless",
          "--isolated",
          "--chromeArg=--no-sandbox",
          "--chromeArg=--disable-dev-shm-usage"
        ],
        "enabled": true
      }
    }
  },
  "agents": {
    "plan": {
      "model": "opencode-go/glm-5.3-flash",
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
}
