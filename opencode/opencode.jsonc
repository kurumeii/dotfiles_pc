{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "compaction": {
    "buffer": "30%"
  },
  "websearch": {
    "provider": "exa"
  },
  "mcp": {
    "servers": {
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "exa": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "oauth": false,
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "agents": {
    "plan": {
      "model": "opencode-go/glm-5.3-flash",
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
}
