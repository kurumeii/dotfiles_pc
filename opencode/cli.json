{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": true,
    "permissions": "autoaccept",
    "sidebar": "hide"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  }
}
