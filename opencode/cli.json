{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "high",
    "image_preview": true
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  },
  "terminal": {
    "copy": "manual"
  },
  "debug": {
    "turn_tokens": "verbose"
  }
}
