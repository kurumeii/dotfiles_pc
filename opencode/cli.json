{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "./herdr-opencode",
    "@streetturtle/opencode-recap",
    {
      "package": "opencode-plugin-usage",
      "options": {
        "providers": {
          "opencode-go": {
            "enabled": true
          }
        }
      }
    },
    {
      "package": "opencode-exit-plan",
      "options": {
        "agent": "build",
        "phrases": [
          "go ahead",
          "ship it",
          "approved",
          "go",
          "proceed"
        ]
      }
    },
    "@dietrichgebert/ponytail",
    {
      "package": "@upstash/context7-opencode",
      "options": {
        "apiKey": "{env:CONTEXT_7_API_KEY}"
      }
    },
    "opencode-bubble-tabs",
    "opencode-ghost"
  ],
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": true,
    "permissions": "autoaccept",
    "sidebar": "auto"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "scroll": {
    "acceleration": true
  }
}
