{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": true,
    "permissions": "autoaccept",
    "sidebar": "auto"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "scroll": {
    "acceleration": true
  }
}
